# Supabase
# Récupérer depuis: https://supabase.com/dashboard/project/drmmgwchoowggpsppilo/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CM-88 : plus de clé service_role. Toutes les données passent par le client
# navigateur (clé anon + session de l'utilisateur), sous RLS.

# CM-86 / CM-88 : inscription ouverte À L'AFFICHAGE (1 = ouverte), lue au BUILD.
# L'ouverture réelle se décide côté Supabase (Auth > Sign ups).
NEXT_PUBLIC_SIGNUP_ENABLED=

# CM-95 : Sentry. DSN public (navigateur), jeton d'envoi des source maps (build).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Facultatif : 1 = page /sentry-test visible (le temps d'un test, sur Preview).
SENTRY_TEST_PAGE=

# CM-89 (PR 4) : origine publique du site (liens d'invitation partagés), lue au
# BUILD, ex. https://v0-gym-workout-tracker-silk.vercel.app. Vide : origine de
# la page sur le web, site de prod dans l'app native (lib/siteUrl.ts).
NEXT_PUBLIC_SITE_URL=
