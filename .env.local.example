# Supabase
# Récupérer depuis: https://supabase.com/dashboard/project/drmmgwchoowggpsppilo/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role — SERVEUR UNIQUEMENT, ne jamais préfixer NEXT_PUBLIC_.
# Utilisée par lib/supabase/server.ts (contourne la RLS). À définir aussi dans
# Vercel (Production + Preview + Development).
SUPABASE_SERVICE_ROLE_KEY=

# CM-58 : palier de connexion, SERVEUR UNIQUEMENT (jamais NEXT_PUBLIC_).
# cookie (défaut si absent) | hybrid | required. Voir supabase/ops/2026-10-cm58-bascule.md.
AUTH_MODE=
# Facultatif, mode hybrid : emails pré-remplis du bloc « Créer mon mot de passe ».
# Format : <uuid profil>=<email>,<uuid profil>=<email>
AUTH_PREFILL_EMAILS=
